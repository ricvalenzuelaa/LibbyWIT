{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "LibbyWIT.jpg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/LibbyWIT.jpg",
      "dest": "/LibbyWIT.jpg"
    },
    {
      "src": "/chat",
      "dest": "/api"
    },
    {
      "src": "/(.*)",
      "dest": "/api"
    }
  ]
}